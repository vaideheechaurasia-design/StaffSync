# StaffSync Server Environment Configuration Example
# Copy this file to .env in local development: cp .env.example .env

# Server Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS Whitelisting)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
# The application supports both MONGODB_URI and MONGO_URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Optional Initial Administrator Seed Configuration
# Used by npm run seed:admin to create the initial HR_ADMIN account
ADMIN_NAME=StaffSync Administrator
ADMIN_EMAIL=admin@staffsync.internal
ADMIN_PASSWORD=replace-with-secure-admin-password
