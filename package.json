{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync — Modern Human Resource Management System (MERN Stack)",
  "private": true,
  "scripts": {
    "start": "npm --prefix server start",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "seed:admin": "npm --prefix server run seed:admin",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "staffsync",
    "hrms",
    "mern",
    "react",
    "express",
    "mongodb",
    "node"
  ],
  "author": "StaffSync Engineering Team",
  "license": "ISC"
}

