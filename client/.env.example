# StaffSync Frontend Environment Configuration Example
# Copy to .env in local development: cp .env.example .env

# Backend API URL (Production Render URL or local development)
# Recommended format: https://<your-render-service>.onrender.com/api/v1
# Note: Both VITE_API_URL and VITE_API_BASE_URL are supported.
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
